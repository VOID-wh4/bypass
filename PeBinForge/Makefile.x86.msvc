OUTDIR = build\x86
OBJDIR = $(OUTDIR)\obj
INCLUDES = /Iinclude

CC = cl
LD = link
COMMON_CFLAGS = /nologo /W4 /O2 /TC /MT $(INCLUDES)
X86_BASE = /BASE:0x10000000

all: dirs $(OBJDIR)\native_stub.obj $(OBJDIR)\managed_pic_stub.obj $(OUTDIR)\simple-memory-loader-x86.exe $(OUTDIR)\thread-memory-loader-x86.exe $(OUTDIR)\native-demo-x86.dll $(OUTDIR)\native-demo-x86.bin $(OUTDIR)\native-exe-demo-x86.exe $(OUTDIR)\native-exe-demo-x86.bin $(OUTDIR)\fixed-exe-demo-x86.exe $(OUTDIR)\fixed-exe-demo-x86.bin $(OUTDIR)\clr-maptest-x86.exe $(OUTDIR)\managed-bin-runner-x86.exe

dirs:
	@if not exist "$(OUTDIR)" mkdir "$(OUTDIR)"
	@if not exist "$(OBJDIR)" mkdir "$(OBJDIR)"

$(OBJDIR)\native_stub.obj: native\pic_stub.c include\pbf_native.h include\pbf_abi.h
	$(CC) /nologo /W4 /O2 /TC /GS- /GR- /Zl /Oi- /Gy- $(INCLUDES) /c /Fo:$@ native\pic_stub.c

$(OBJDIR)\native_bin_runner.obj: runner\native_bin_runner.c include\pbf_native.h include\pbf_abi.h
	$(CC) $(COMMON_CFLAGS) /c /Fo:$@ runner\native_bin_runner.c

$(OUTDIR)\native-bin-runner-x86.exe: $(OBJDIR)\native_bin_runner.obj Makefile.x86.msvc
	$(LD) /nologo /MACHINE:X86 $(X86_BASE) /FIXED /DYNAMICBASE:NO /NXCOMPAT /OUT:$@ $(OBJDIR)\native_bin_runner.obj advapi32.lib

$(OBJDIR)\simple_memory_loader.obj: runner\simple_memory_loader_x86.c
	$(CC) /nologo /W4 /O2 /TC /GS- /GR- /Zl /Oi- /c /Fo:$@ runner\simple_memory_loader_x86.c

$(OUTDIR)\simple-memory-loader-x86.exe: $(OBJDIR)\simple_memory_loader.obj Makefile.x86.msvc
	$(LD) /nologo /NODEFAULTLIB /MACHINE:X86 /BASE:0x00400000 /FIXED /DYNAMICBASE:NO /NXCOMPAT /SUBSYSTEM:CONSOLE /ENTRY:PbfSimpleLoaderEntry /OUT:$@ $(OBJDIR)\simple_memory_loader.obj kernel32.lib

$(OBJDIR)\thread_memory_loader.obj: runner\thread_memory_loader.c include\pbf_abi.h
	$(CC) $(COMMON_CFLAGS) /MT /c /Fo:$@ runner\thread_memory_loader.c

$(OUTDIR)\thread-memory-loader-x86.exe: $(OBJDIR)\thread_memory_loader.obj Makefile.x86.msvc
	$(LD) /nologo /MACHINE:X86 /BASE:0x10000000 /DYNAMICBASE /NXCOMPAT /SUBSYSTEM:CONSOLE /OUT:$@ $(OBJDIR)\thread_memory_loader.obj

$(OBJDIR)\native_dependency_leaf.obj: payloads\native_dependency_leaf.c
	$(CC) /nologo /W4 /O2 /TC /GS- /Zl $(INCLUDES) /c /Fo:$@ payloads\native_dependency_leaf.c

$(OUTDIR)\pbfleaf-x86.dll: $(OBJDIR)\native_dependency_leaf.obj
	$(LD) /nologo /DLL /MACHINE:X86 /DYNAMICBASE /NXCOMPAT /ENTRY:DllMain /OUT:$@ /IMPLIB:$(OUTDIR)\pbfleaf-x86.lib $(OBJDIR)\native_dependency_leaf.obj

$(OUTDIR)\pbfleaf-x86.lib: $(OUTDIR)\pbfleaf-x86.dll

$(OBJDIR)\native_dependency.obj: payloads\native_dependency.c
	$(CC) /nologo /W4 /O2 /TC /GS- /Zl $(INCLUDES) /c /Fo:$@ payloads\native_dependency.c

$(OUTDIR)\pbfdep-x86.dll: $(OBJDIR)\native_dependency.obj $(OUTDIR)\pbfleaf-x86.lib
	$(LD) /nologo /DLL /MACHINE:X86 /DYNAMICBASE /NXCOMPAT /ENTRY:DllMain /OUT:$@ /IMPLIB:$(OUTDIR)\pbfdep-x86.lib $(OBJDIR)\native_dependency.obj $(OUTDIR)\pbfleaf-x86.lib

$(OUTDIR)\pbfdep-x86.lib: $(OUTDIR)\pbfdep-x86.dll

$(OBJDIR)\native_demo.obj: payloads\native_demo.c include\pbf_abi.h
	$(CC) /nologo /W4 /O2 /TC /GS- /Zl $(INCLUDES) /c /Fo:$@ payloads\native_demo.c

$(OUTDIR)\native-demo-x86.dll: $(OBJDIR)\native_demo.obj $(OUTDIR)\pbfdep-x86.lib
	$(LD) /nologo /DLL /MACHINE:X86 /DYNAMICBASE /NXCOMPAT /ENTRY:DllMain /OUT:$@ $(OBJDIR)\native_demo.obj $(OUTDIR)\pbfdep-x86.lib kernel32.lib

$(OBJDIR)\native_exe_demo.obj: payloads\native_exe_demo.c
	$(CC) $(COMMON_CFLAGS) /MT /c /Fo:$@ payloads\native_exe_demo.c

$(OUTDIR)\native-exe-demo-x86.exe: $(OBJDIR)\native_exe_demo.obj $(OUTDIR)\pbfdep-x86.lib
	$(LD) /nologo /MACHINE:X86 $(X86_BASE) /DYNAMICBASE /NXCOMPAT /SUBSYSTEM:CONSOLE /OUT:$@ $(OBJDIR)\native_exe_demo.obj $(OUTDIR)\pbfdep-x86.lib

$(OUTDIR)\fixed-exe-demo-x86.exe: $(OBJDIR)\native_exe_demo.obj $(OUTDIR)\pbfdep-x86.lib
	$(LD) /nologo /MACHINE:X86 /BASE:0x00400000 /FIXED /DYNAMICBASE:NO /NXCOMPAT /SUBSYSTEM:CONSOLE /OUT:$@ $(OBJDIR)\native_exe_demo.obj $(OUTDIR)\pbfdep-x86.lib

$(OUTDIR)\native-demo-x86.bin: $(OBJDIR)\native_stub.obj $(OUTDIR)\native-demo-x86.dll build\native-bin-gen.exe
	build\native-bin-gen.exe $(OBJDIR)\native_stub.obj $(OUTDIR)\native-demo-x86.dll $@ --force

$(OUTDIR)\native-exe-demo-x86.bin: $(OBJDIR)\native_stub.obj $(OUTDIR)\native-exe-demo-x86.exe build\native-bin-gen.exe
	build\native-bin-gen.exe $(OBJDIR)\native_stub.obj $(OUTDIR)\native-exe-demo-x86.exe $@ --force

$(OUTDIR)\fixed-exe-demo-x86.bin: $(OBJDIR)\native_stub.obj $(OUTDIR)\fixed-exe-demo-x86.exe build\native-bin-gen.exe
	build\native-bin-gen.exe $(OBJDIR)\native_stub.obj $(OUTDIR)\fixed-exe-demo-x86.exe $@ --force

$(OBJDIR)\managed_pic_stub.obj: managed\pic_stub.c include\pbf_managed.h include\pbf_abi.h
	$(CC) /nologo /W4 /O2 /TC /GS- /GR- /Zl /Oi- /Gy- $(INCLUDES) /c /Fo:$@ managed\pic_stub.c

$(OBJDIR)\clr_maptest.obj: managed\clr_maptest.c
	$(CC) $(COMMON_CFLAGS) /wd4201 /c /Fo:$@ managed\clr_maptest.c

$(OUTDIR)\clr-maptest-x86.exe: $(OBJDIR)\clr_maptest.obj
	$(LD) /nologo /MACHINE:X86 /OUT:$@ $(OBJDIR)\clr_maptest.obj mscoree.lib ole32.lib oleaut32.lib

$(OBJDIR)\clr_host_lib.obj: managed\clr_maptest.c include\pbf_clr_host.h
	$(CC) $(COMMON_CFLAGS) /wd4201 /DPBF_CLR_LIBRARY /c /Fo:$@ managed\clr_maptest.c

$(OBJDIR)\managed_bin_runner.obj: runner\managed_bin_runner.c include\pbf_managed.h include\pbf_clr_host.h include\pbf_abi.h
	$(CC) $(COMMON_CFLAGS) /c /Fo:$@ runner\managed_bin_runner.c

$(OUTDIR)\managed-bin-runner-x86.exe: $(OBJDIR)\managed_bin_runner.obj $(OBJDIR)\clr_host_lib.obj
	$(LD) /nologo /MACHINE:X86 /BASE:0x10000000 /DYNAMICBASE /NXCOMPAT /OUT:$@ $(OBJDIR)\managed_bin_runner.obj $(OBJDIR)\clr_host_lib.obj mscoree.lib ole32.lib oleaut32.lib advapi32.lib

clean:
	@if exist "$(OUTDIR)" rmdir /S /Q "$(OUTDIR)"
